# Copy these two lines into android/local.properties (git-ignored), or export them as environment variables.
# Only PUBLIC values belong here. Find them in Supabase: Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# NEVER put the service_role key, the database password or SMTP credentials here.
# Optional native push: download your own google-services.json from the Firebase console into android/app/ (never commit it).
