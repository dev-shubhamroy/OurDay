# Copy to .env.local (never commit .env.local). Only PUBLIC values belong here.
# Find them in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# NEVER put the service_role key, database password or SMTP credentials in this file or in any VITE_ variable.
